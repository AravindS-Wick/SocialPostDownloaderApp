{
  "expo": {
    "name": "SocialSaver",
    "slug": "socialsaver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socialsaver.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SocialSaver needs access to your photo library to save downloaded videos, photos, and audio files.",
        "NSPhotoLibraryAddUsageDescription": "SocialSaver needs access to your photo library to save downloaded videos, photos, and audio files."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.socialsaver.app",
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "SocialSaver needs access to your photos to save downloaded content.",
          "savePhotosPermission": "SocialSaver needs access to your photos to save downloaded content.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ]
  }
}
