{
  "expo": {
    "name": "SocialPostOwnerUI",
    "slug": "socialpostownerui",
    "scheme": "socialpostownerui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3498db"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to save downloads.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save downloaded media to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.socialmediadownloader.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#3498db"
      },
      "package": "com.socialmediadownloader.app",
      "permissions": [
        "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO", "READ_MEDIA_AUDIO", "WRITE_EXTERNAL_STORAGE", "READ_EXTERNAL_STORAGE", "ACCESS_MEDIA_LOCATION", "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4600ba8c-86d8-4afa-a96f-364c5e4d4e61"
      }
    },
    "owner": "miens"
  }
}
