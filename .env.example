# Expo / React Native
# Note: API_BASE_URL is configured in src/utils/constants.ts (not via env vars)
# This is because Expo requires compile-time constants for bundling.
#
# To change the API host:
#   - Edit src/utils/constants.ts
#   - iOS simulator: http://localhost:2500
#   - Android emulator: http://10.0.2.2:2500
#   - Physical device: http://<your-lan-ip>:2500
#   - Production: https://your-api-domain.com

# Ad SDK (backlog — not yet integrated)
# ADMOB_BANNER_ID=
# ADMOB_INTERSTITIAL_ID=
