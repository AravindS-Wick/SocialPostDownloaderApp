{
  "name": "social-post-downloader-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8081",
    "start:dev": "expo start --dev-client --port 8081",
    "start:web": "expo start --web --port 8081",
    "start:server": "cd server && npm run dev",
    "build": "expo build",
    "build:web": "expo build:web",
    "build:server": "cd server && npm run build",
    "test": "jest",
    "test:server": "cd server && npm test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "dev": "concurrently \"npm run start:server\" \"npm run start\"",
    "postinstall": "echo 'postinstall complete'",
    "clean": "expo r -c && cd server && rm -rf dist node_modules && npm install",
    "audit-fix": "npm audit fix && cd server && npm audit fix",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "keywords": [
    "react-native",
    "expo",
    "social-media",
    "downloader",
    "instagram",
    "twitter",
    "youtube",
    "mobile-app"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "description": "A React Native mobile application for downloading posts from popular social media platforms including Instagram, Twitter, and YouTube.",
  "expo.doctor.reactNativeDirectoryCheck.listUnknownPackages": false,
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
