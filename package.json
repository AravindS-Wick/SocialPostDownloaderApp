    "react-native-web": "^0.21.2",
    "react-navigation": "^5.0.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "typescript": "~5.9.2",
    "uuid": "^11.1.0"
  },
